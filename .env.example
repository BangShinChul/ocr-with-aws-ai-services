# Copy to .env, or let ./setup.sh write it for you.
# Non-empty values here take precedence over shell environment variables.

# AWS CLI profile and Region the demo calls (leave AWS_PROFILE empty for the default credential chain)
AWS_PROFILE=
AWS_REGION=ap-northeast-2

# Bedrock cross-Region inference profile prefix: global | us | eu | apac | ...
#   global routes requests to any commercial Region; a geographic prefix keeps them in that geography
OCR_MODEL_SCOPE=global

# Private S3 bucket, only needed for PDF input to Textract and for BDA
OCR_S3_BUCKET=
OCR_BDA_ENABLED=false

# Optional
# OCR_DATA_DIR=data                  # documents/schema/truth folder (default: data, else bundled sample)
# OCR_RESULTS_DIR=results
# OCR_POSTPROCESSING_MODEL=          # model that turns Textract/BDA text into JSON (default: Sonnet 5.5)
# OCR_HOST=127.0.0.1                 # keep on loopback: the UI has no login
# OCR_PORT=7860
